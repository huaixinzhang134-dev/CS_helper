# CS Match Pro 环境变量配置
# 复制为 server/.env 后填写真实值（server/.env 已被 .gitignore 忽略，不会进仓库）

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=你的数据库密码
DB_NAME=cs_match_pro

# ---------- 服务 ----------
PORT=3001
NODE_ENV=production

# ---------- 密钥 ----------
# AUTH_SECRET：用户 token（微信/网页登录）的签名密钥，必填。
#   缺失时 middleware/auth.js 的 secret 为空串，签发出的 token 可被任意伪造。
AUTH_SECRET=用 openssl rand -hex 32 生成

# ADMIN_SECRET：管理员 token 的签名密钥，建议单独设置。
#   缺失时回退到 AUTH_SECRET（功能正常）；两者都缺失则 /api/admin/login 返回 503 拒绝签发。
#   更换该值会使已签发的管理员 token 全部失效，管理员需重新登录。
ADMIN_SECRET=用 openssl rand -hex 16 生成

# SYNC_TOKEN：爬虫推送接口 /api/matches/sync 的鉴权 token，必填。
#   缺失时该接口返回 503 并拒绝所有请求（爬虫会推送失败）。
#   服务器上的爬虫进程与本变量读取同一份 .env，改完需同时重启 api 与 crawler。
SYNC_TOKEN=用 openssl rand -hex 16 生成

# ---------- 微信小程序 ----------
# 缺失时 /api/users/login 会跳过 code2session，按 dev_<md5(code)> 直接建号（仅限本地联调）
WX_APPID=你的小程序 AppID
WX_SECRET=你的小程序 AppSecret

# ---------- 爬虫（通常由 ecosystem.config.js 注入，无需写在 .env）----------
# API_BASE=http://127.0.0.1:3001
# CRAWLER_INTERVAL=900000
# CRAWLER_DRY_RUN=0
