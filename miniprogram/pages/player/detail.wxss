/* miniprogram/pages/player/detail.wxss */

.detail-page {
  padding: 40rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  margin-bottom: 60rpx;
}

.avatar-lg {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid var(--primary-color);
  margin-right: 40rpx;
  background-color: var(--bg-input);
}

.info {
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.nickname {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-right: 20rpx;
}

.country-badge {
  font-size: 24rpx;
  background-color: rgba(127, 127, 127, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: var(--text-primary);
  margin-right: 12rpx;
}

.status-badge {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: var(--text-primary);
}

.status-active {
  background-color: rgba(76, 175, 80, 0.25);
}

.status-retired {
  background-color: rgba(244, 67, 54, 0.2);
}

.status-coach {
  background-color: rgba(33, 150, 243, 0.25);
}

.status-free_agent {
  background-color: rgba(255, 152, 0, 0.25);
}

.status-unknown {
  background-color: rgba(127, 127, 127, 0.2);
}

/* 状态颜色图例 */
.status-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: var(--text-secondary);
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 6rpx;
}

.dot-active {
  background-color: rgba(76, 175, 80, 0.7);
}

.dot-coach {
  background-color: rgba(33, 150, 243, 0.7);
}

.dot-free_agent {
  background-color: rgba(255, 152, 0, 0.7);
}

.dot-retired {
  background-color: rgba(244, 67, 54, 0.5);
}

.real-name {
  font-size: 28rpx;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
}

.team-info {
  font-size: 28rpx;
}

.team-label {
  color: var(--text-primary);
  font-size: 18px;
  margin-right: 10rpx;
}

.team-val {
  color: var(--primary-color);
  font-size: 18px;
  font-weight: bold;
}

/* 曾属队伍 */
.former-teams {
  margin-top: 12rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: flex-start;
}

.former-teams-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  flex: 1;
}

.former-team-tag {
  font-size: 22rpx;
  color: var(--text-primary);
  background-color: var(--bg-input);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  border: 1rpx solid var(--border-color);
}

.stats-card {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 100rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
}

.stats-grid {
  display: flex;
  justify-content: space-between;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.loading {
  text-align: center;
  margin-top: 100rpx;
  color: var(--text-primary);
}

.stats-detail-card {
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-top: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
}

.stats-detail-title {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.stats-detail-list {
  display: flex;
  flex-direction: column;
}

.stats-detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 64rpx;
  padding: 0 10rpx;
}

.stats-detail-label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.stats-detail-value {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: bold;
}

/* ====== 绰号展示 ====== */
.alias-section {
  margin-top: 30rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--border-color);
}

.alias-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.alias-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.alias-tag {
  font-size: 24rpx;
  color: var(--primary-color);
  background: rgba(0, 102, 204, 0.1);
  border: 1rpx solid rgba(0, 102, 204, 0.3);
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
}

/* ====== 提交绰号 ====== */
.action-bar {
  margin-top: 40rpx;
  text-align: center;
}

.btn-nickname {
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  color: var(--text-primary);
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border-radius: 12rpx;
}

.btn-nickname:active {
  opacity: 0.7;
}

/* ====== 弹窗遮罩 ====== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--modal-backdrop);
  z-index: 100;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-content {
  background: var(--modal-bg);
  border-radius: 20rpx;
  width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}

.nickname-modal {
  padding: 40rpx;
}

.nickname-input {
  background: var(--bg-input);
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  color: var(--text-primary);
  margin: 30rpx 0;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
  padding: 20rpx 0 0;
  margin-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
}

.btn-secondary {
  background: var(--bg-input);
  color: var(--text-primary);
  border: 1rpx solid var(--border-color);
  padding: 16rpx 40rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.btn-primary {
  background: var(--primary-color);
  color: #fff;
  border: none;
  padding: 16rpx 40rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.btn-primary[disabled] {
  opacity: 0.6;
}
