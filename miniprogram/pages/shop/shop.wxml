<view class="container shop-page">
  <!-- 头部：代币余额 -->
  <view class="header-balance">
    <text class="balance-label">我的代币</text>
    <view class="balance-row">
      <text class="balance-icon">🪙</text>
      <text class="balance-amount">{{coins}}</text>
      <view class="header-actions">
        <button class="ad-btn" bindtap="onWatchAd" disabled="{{isAdWatching}}" size="mini">{{isAdWatching ? '加载中...' : '📺 广告得66代币'}}</button>
        <button class="record-btn" bindtap="onShowRecords" size="mini">📋 记录</button>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 商品列表 -->
  <view class="shop-list" wx:else>
    <view class="section-title">道具商城</view>
    <view class="shop-item" wx:for="{{shopItems}}" wx:key="id">
      <view class="item-icon-wrap">
        <text class="item-icon-emoji">{{item.icon === '/assets/icons/hint.png' ? '💡' : '⭐'}}</text>
      </view>
      <view class="item-info">
        <text class="item-name">{{item.name}}</text>
        <text class="item-desc">{{item.description}}</text>
        <text class="item-owned" wx:if="{{item.bought > 0}}">拥有: {{item.bought}}个</text>
      </view>
      <view class="item-action">
        <text class="item-price">🪙 {{item.price}}</text>
        <button class="buy-btn" data-id="{{item.id}}" bindtap="onBuy" disabled="{{buying}}" size="mini">购买</button>
      </view>
    </view>

    <view class="shop-empty" wx:if="{{shopItems.length === 0}}">
      <text>暂无商品上架</text>
    </view>
  </view>

  <!-- 代币记录弹窗 -->
  <view class="modal-mask" wx:if="{{showRecordsModal}}" bindtap="onRecordsModalClose" style="z-index:100;">
    <view class="modal-content" catchtap="" style="max-height:70vh;">
      <view class="modal-title">代币记录</view>
      <scroll-view scroll-y style="max-height:50vh;">
        <view class="record-item" wx:for="{{coinRecords}}" wx:key="index" style="display:flex;align-items:center;padding:16rpx 24rpx;border-bottom:1px solid var(--border);">
          <view style="flex:1;">
            <text style="font-size:26rpx;font-weight:500;">{{item.description || item.typeLabel}}</text>
            <text style="display:block;font-size:20rpx;color:var(--text-muted);margin-top:4rpx;">{{item.time}}</text>
          </view>
          <text style="font-size:28rpx;font-weight:600;color:{{item.isIncome ? 'var(--success)' : 'var(--danger)'}};">{{item.isIncome ? '+' : ''}}{{item.amount}}</text>
        </view>
      </scroll-view>
      <view class="modal-footer" style="justify-content:center;">
        <button class="btn-secondary" bindtap="onRecordsModalClose" size="mini">关闭</button>
      </view>
    </view>
  </view>
</view>
